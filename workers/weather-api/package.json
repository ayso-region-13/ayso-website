{
  "name": "ayso13-weather-api",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that fetches Tempest + NWS data, computes WBGT, and serves /api/weather for the AYSO Region 13 weather page.",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "dev": "wrangler dev",
    "secrets:dev-vars": "op inject --account=my.1password.com -f -i .dev.vars.tpl -o .dev.vars",
    "deploy": "wrangler deploy",
    "deploy:op": "op run --account=my.1password.com --env-file=../../.ayso.op.env -- npm run deploy",
    "tail": "wrangler tail",
    "tail:op": "op run --account=my.1password.com --env-file=../../.ayso.op.env -- npm run tail",
    "export-log": "bash scripts/export-log.sh",
    "export-log:op": "op run --account=my.1password.com --env-file=../../.ayso.op.env -- npm run export-log"
  },
  "devDependencies": {
    "wrangler": "^4.87.0"
  }
}
