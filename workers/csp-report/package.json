{
  "name": "ayso13-csp-report",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that collects Content-Security-Policy violation reports. Stores 30 days of reports in KV; admin GET endpoint lists recent ones for review.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:op": "op run --account=my.1password.com --env-file=../../.ayso.op.env -- npm run deploy",
    "tail": "wrangler tail",
    "tail:op": "op run --account=my.1password.com --env-file=../../.ayso.op.env -- npm run tail",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "^4.87.0"
  },
  "type": "module"
}
