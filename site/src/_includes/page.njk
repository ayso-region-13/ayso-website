---
layout: base.njk
---
{# ── Page layout — used for all standard content pages ─────────────── #}

{# Build breadcrumb from section nav data #}
{% set sectionNav = null %}
{% for navItem in navigation %}
  {% if page.url | isActiveSection(navItem.url) %}
    {% set sectionNav = navItem %}
  {% endif %}
{% endfor %}

{# ── Page header ─────────────────────────────────────────────────── #}
<div class="bg-brand-cream">
  <div class="max-w-screen-xl mx-auto px-4 py-8 md:py-10">

    {# Breadcrumb #}
    {% if sectionNav and sectionNav.url != page.url %}
    <nav class="text-sm text-brand-maroon mb-3" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-dark transition-colors">Home</a>
      <span class="mx-2 opacity-40">/</span>
      <a href="{{ sectionNav.url }}" class="hover:text-brand-dark transition-colors">{{ sectionNav.label }}</a>
      {% if page.url != sectionNav.url %}
      <span class="mx-2 opacity-40">/</span>
      <span class="text-brand-dark font-medium">{{ title }}</span>
      {% endif %}
    </nav>
    {% endif %}

    <h1 class="text-3xl md:text-4xl font-extrabold text-brand-dark leading-tight">{{ title }}</h1>

    {% if description %}
    <p class="mt-2 text-brand-maroon text-lg leading-relaxed max-w-2xl">{{ description }}</p>
    {% endif %}

    {# Compact address + one-tap directions (opens the visitor's Maps app). #}
    {% if section == "fields" and placeAddress %}
    {% if placeLat and placeLon %}{% set dirDest = placeLat ~ "," ~ placeLon %}{% else %}{% set dirDest = placeAddress ~ ", " ~ (placeLocality or "Pasadena") ~ ", CA" %}{% endif %}
    <p class="mt-3 text-sm text-brand-dark">
      {{ placeAddress }}{% if placeLocality %}, {{ placeLocality }}{% endif %}{% if placePostalCode %} {{ placePostalCode }}{% endif %}
      <a href="https://www.google.com/maps/dir/?api=1&destination={{ dirDest | urlencode }}" target="_blank" rel="noopener" class="ml-1 whitespace-nowrap font-semibold text-brand-red-dark hover:text-brand-dark">Get directions →</a>
    </p>
    {% endif %}

  </div>
</div>

{# ── Two-tone signature strip ────────────────────────────────────── #}
<div class="h-1.5 bg-brand-maroon"></div>
<div class="h-1 bg-brand-red"></div>

{# ── Field status bar (opt-in via frontmatter `showFieldStatus: true`) ──
   Markup and link behaviour live in field-status.njk, shared with home.njk. #}
{% if showFieldStatus %}{% include "field-status.njk" %}{% endif %}

{# Wide hero strip removed — page imagery now lives in the body markdown.
   The `heroImage` frontmatter field is still used by base.njk for og:image
   (social shares). #}

{# ── Content area ────────────────────────────────────────────────── #}
<div class="max-w-screen-xl mx-auto px-4 py-10">
  <div class="flex flex-col lg:flex-row gap-10">

    {# Main content #}
    <article class="flex-1 min-w-0">
      {# Field Quick Info — only renders on field pages when at least one
         facility detail is filled in via frontmatter. #}
      {% if section == "fields" and (parking or restrooms or surface or lighting or snackBar) %}
      <div class="bg-brand-cream rounded-lg border border-brand-cream p-4 mb-6 max-w-3xl not-prose">
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-red-dark mb-3">Field Info</p>
        <dl class="grid grid-cols-1 sm:grid-cols-[max-content_1fr] gap-x-6 gap-y-2 text-sm">
          {% if parking %}<dt class="font-semibold text-brand-dark">Parking</dt><dd class="text-brand-dark/80">{{ parking }}</dd>{% endif %}
          {% if restrooms %}<dt class="font-semibold text-brand-dark">Restrooms</dt><dd class="text-brand-dark/80">{{ restrooms }}</dd>{% endif %}
          {% if surface %}<dt class="font-semibold text-brand-dark">Surface</dt><dd class="text-brand-dark/80">{{ surface }}</dd>{% endif %}
          {% if lighting %}<dt class="font-semibold text-brand-dark">Lighting</dt><dd class="text-brand-dark/80">{{ lighting }}</dd>{% endif %}
          {% if snackBar %}<dt class="font-semibold text-brand-dark">Snack bar</dt><dd class="text-brand-dark/80">{{ snackBar }}</dd>{% endif %}
        </dl>
      </div>
      {% endif %}

      {# Field Maps — fetched at build time from the platform's public field-map
         API (site/src/_data/fieldmaps.js -> lib/fetchFieldMaps.js), keyed by
         venue slug, so fieldmaps[page.fileSlug] is this field's doc. Degrades to
         nothing when a field has no saved map (most, initially). Distinct
         wrapper classes keep it clear of the field-info-bottom transform. #}
      {# Maps render at the top of the article (after the TOC, before the prose),
         so the page reads: address → field maps → Location/directions → rest.
         Order: game, then practice, then any other named layouts (e.g. "A"/"B"). #}
      {% if section == "fields" %}
      {% set fmaps = fieldmaps[page.fileSlug] %}
      {% set cx = complex and collections.complexes[complex] %}
      {% set cxWayfinder = cx and cx.wayfinder %}

      {# Region overview map at the top of the /fields/ index — the
         editor-generated overview (eleventy-img serves it as responsive WebP).
         Gated on the PNG existing so a fresh checkout never references a missing
         file. #}
      {% if page.url == "/fields/" and overviewMap.ready and fieldmaps.overview and fieldmaps.overview.variants and fieldmaps.overview.variants.map %}
      {% set ovm = fieldmaps.overview.variants.map %}
      <figure class="not-prose mb-6 max-w-3xl rounded-lg overflow-hidden border border-brand-cream">
        {{ ovm.pictureHtml | safe }}
      </figure>
      {% endif %}

      {# Cross-link to sibling fields in the same complex (e.g. the FIS fields). #}
      {% if cx and cx.members.length > 1 %}
      <p class="not-prose mb-5 max-w-3xl text-sm bg-brand-cream rounded-lg p-3">
        <span class="font-semibold text-brand-red-dark">Part of {{ cx.name }}:</span>
        {% for m in cx.members %}{% if m.slug != page.fileSlug %}<a href="{{ m.url }}" class="ml-1 font-medium text-brand-red-dark underline hover:text-brand-dark">{{ m.title }}</a>{% endif %}{% endfor %}
      </p>
      {% endif %}

      {# Field Maps — own game/practice maps, plus a shared complex wayfinder.
         Each map is its own anchored section so the in-page TOC links to it.
         Order: address → maps → Location/directions → rest. #}
      {% if (fmaps and fmaps.variants) or cxWayfinder %}
      {% macro mapsection(v, heading, anchor) %}
      <section class="not-prose mb-6 max-w-3xl">
        <h2 id="{{ anchor }}" class="text-lg font-bold text-brand-red-dark mb-3">{{ heading }}</h2>
        <figure class="rounded-lg overflow-hidden border border-brand-cream">
          <a href="{{ v.png }}" class="gmap-lightbox block" data-gallery="fieldmaps-{{ page.fileSlug }}"
             data-title="{{ heading }}" aria-label="Enlarge {{ heading }}">
            {{ v.pictureHtml | safe }}
          </a>
        </figure>
        <p class="text-xs text-brand-dark/60 mt-1">Tap to enlarge — scroll or pinch to zoom, drag to pan.</p>
      </section>
      {% endmacro %}
      <link rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/glightbox@3.3.1/dist/css/glightbox.min.css"
            integrity="sha384-GPAzSuZc0kFvdIev6wm9zg8gnafE8tLso7rsAYQfc9hAdWCpOcpcNI5W9lWkYcsd"
            crossorigin="anonymous">
      <div data-field-maps>
        {% if fmaps and fmaps.variants %}
        {% if fmaps.variants.game %}{{ mapsection(fmaps.variants.game, "Field Map for Games", "field-map-games") }}{% endif %}
        {% if fmaps.variants.practice %}{{ mapsection(fmaps.variants.practice, "Field Map for Practices", "field-map-practices") }}{% endif %}
        {# Own wayfinder only when NOT in a complex — complexes share one below. #}
        {% if fmaps.variants.wayfinder and not complex %}{{ mapsection(fmaps.variants.wayfinder, "Getting Around", "field-map-wayfinder") }}{% endif %}
        {% for vid, v in fmaps.variants %}{% if vid != "game" and vid != "practice" and vid != "wayfinder" %}{{ mapsection(v, "Field Map — " + (v.label or vid), "field-map-" + vid) }}{% endif %}{% endfor %}
        {% endif %}
        {# Shared wayfinder for the whole complex (hosted on one member). #}
        {% if cxWayfinder %}{{ mapsection(cxWayfinder, "Getting Around — " + cx.name, "field-map-wayfinder") }}{% endif %}
      </div>
      <script src="https://cdn.jsdelivr.net/npm/glightbox@3.3.1/dist/js/glightbox.min.js"
              integrity="sha384-MZZbZ6RXJudK43v1qY1zOWKOU2yfeBPatuFoKyHAaAgHTUZhwblRTc9CphTt4IGQ"
              crossorigin="anonymous"></script>
      <script>
        (function () {
          function init() { if (window.GLightbox) GLightbox({ selector: '.gmap-lightbox', zoomable: true, touchNavigation: true, loop: true }); }
          if (document.readyState !== 'loading') init(); else document.addEventListener('DOMContentLoaded', init);
        })();
      </script>
      {% endif %}
      {% endif %}

      <div class="prose max-w-3xl">
        {# Hide the H1 in markdown since we display it in the page header above #}
        <style>
          article .prose > h1:first-child { display: none; }
        </style>
        {{ content | safe }}
      </div>
    </article>

    {# Sidebar: section links #}
    {% if sectionNav and sectionNav.children %}
    <aside class="lg:w-64 shrink-0">
      <nav class="sticky top-20" aria-label="Section navigation">
        <div class="bg-gray-50 rounded-xl border border-gray-200 overflow-hidden">
          <div class="bg-brand-maroon text-white px-4 py-3">
            <p class="text-sm font-semibold">{{ sectionNav.label }}</p>
          </div>
          <ul>
            {% for child in sectionNav.children %}
            {% if child.divider %}
            <li class="px-4 pt-3 pb-1">
              <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">{{ child.dividerLabel }}</span>
            </li>
            {% endif %}
            <li>
              <a href="{{ child.url }}"
                 class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-brand-cream hover:text-brand-red-dark transition-colors border-b border-gray-100 last:border-0
                        {% if page.url == child.url %}bg-brand-cream text-brand-red-dark font-medium{% endif %}">
                {{ child.label }}
              </a>
            </li>
            {% endfor %}
          </ul>
        </div>
      </nav>
    </aside>
    {% endif %}

  </div>
</div>
