---
layout: base.njk
---
{# ── Home page layout ────────────────────────────────────────────── #}

{# ── Quick action bar ─────────────────────────────────────────────── #}
<div class="bg-brand-maroon">
  <div class="max-w-screen-xl mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-white/10">
      <a href="/schedules/games/" class="flex flex-col items-center gap-1 py-4 px-3 text-white hover:bg-black/20 transition-colors text-center">
        <svg class="w-6 h-6 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <span class="text-xs font-bold uppercase tracking-wider">Game Schedule</span>
      </a>
      <a href="/fields/" class="flex flex-col items-center gap-1 py-4 px-3 text-white hover:bg-black/20 transition-colors text-center">
        <svg class="w-6 h-6 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <span class="text-xs font-bold uppercase tracking-wider">Field Locations</span>
      </a>
      <a href="/families/" class="flex flex-col items-center gap-1 py-4 px-3 text-white hover:bg-black/20 transition-colors text-center">
        <svg class="w-6 h-6 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <span class="text-xs font-bold uppercase tracking-wider">New Families</span>
      </a>
      <a href="/volunteers/" class="flex flex-col items-center gap-1 py-4 px-3 text-white hover:bg-black/20 transition-colors text-center">
        <svg class="w-6 h-6 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
        <span class="text-xs font-bold uppercase tracking-wider">Volunteer</span>
      </a>
    </div>
  </div>
</div>

{# ── Two-tone signature strip — lighter red below the maroon nav ── #}
<div class="h-1.5 bg-brand-red"></div>

{# ── Field status widget ─────────────────────────────────────────── #}
{% if fieldstatus.enabled %}
<div class="{% if fieldstatus.status | lower == 'closed' %}bg-brand-red-dark{% elif fieldstatus.status | lower == 'monitoring' %}bg-brand-gold{% else %}bg-brand-green{% endif %}">
  <div class="max-w-screen-xl mx-auto px-4 py-2.5 flex items-center justify-center gap-3">
    <span class="text-xl" aria-hidden="true">⚽</span>
    <p class="{% if fieldstatus.status | lower == 'closed' %}text-white{% else %}text-brand-dark{% endif %} text-sm font-bold uppercase tracking-wider">
      Fields are {{ fieldstatus.status }}{% if fieldstatus.message %} — {{ fieldstatus.message }}{% endif %}
    </p>
    <span class="text-xl" aria-hidden="true">⚽</span>
  </div>
</div>
{% endif %}

{# ── Hero ────────────────────────────────────────────────────────── #}
<section class="relative overflow-hidden bg-brand-dark min-h-[560px]">

  {# Background images — `heroes` is shuffled at build time in
     _data/heroes.js so each deploy ships a different first/LCP image.
     The first wrapper is eager + fetchpriority=high. Wrappers 2-5 are
     display:none + lazy. After the LCP measurement window closes, the
     rotation script below cycles through them (decode → cross-fade). #}
  <div class="absolute inset-0">
    {% for hero in heroes %}
    <div class="hero-pic-wrapper {% if not loop.first %}hidden {% endif %}absolute inset-0 transition-opacity duration-700">
      <img class="absolute inset-0 w-full h-full object-cover object-center"
           src="{{ hero.src }}"
           alt="{{ hero.alt }}"
           sizes="100vw"
           {% if loop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
    </div>
    {% endfor %}
  </div>

  {# Image 1 is always visible by default, so no noscript fallback is
     needed — JS-disabled clients get image 1 too. #}

  {# Dark gradient overlay — darkens the left side where the headline sits so
     contrast against the white/70 and red-dark/75 text blocks stays above
     WCAG AA regardless of which of the 5 random hero photos loads. #}
  <div class="absolute inset-0 bg-gradient-to-r from-black/55 via-black/25 to-transparent pointer-events-none" aria-hidden="true"></div>

  {# Hero content #}
  <div class="relative max-w-screen-xl mx-auto px-4 py-16 md:py-20 flex flex-col justify-center min-h-[560px]">
    <h1 class="font-extrabold leading-[1] tracking-tight mb-8 flex flex-col items-start gap-1">
      <span class="bg-white/70 text-brand-red-dark text-[clamp(2.5rem,11vw,9rem)] px-3 pt-1 pb-2">SOCCER</span>
      <span class="bg-brand-red-dark/75 text-white text-[clamp(2.5rem,11vw,9rem)] px-3 pt-1 pb-2">FOR EVERYONE</span>
    </h1>
    <div class="flex flex-wrap gap-3">
      {# Button 1: lighter red body, darker line #}
      <a href="/register/" class="group inline-block">
        <div class="bg-brand-red text-white font-bold uppercase tracking-wider text-base md:text-xl px-6 py-3 group-hover:opacity-90 transition-opacity">
          Register for Soccer
        </div>
        <div class="h-1.5 bg-brand-red-dark"></div>
      </a>
      {# Button 2: darker red body, lighter line #}
      <a href="/programs/" class="group inline-block">
        <div class="bg-brand-red-dark text-white font-bold uppercase tracking-wider text-base md:text-xl px-6 py-3 group-hover:opacity-90 transition-opacity">
          View Programs
        </div>
        <div class="h-1.5 bg-brand-red"></div>
      </a>
    </div>
  </div>
</section>

{# ── Hero rotation — the first wrapper is the LCP candidate and paints
     first. After LCP measurement closes (first interaction or 3 s
     fallback), this cycles through the rest sequentially (2 → 3 → 4 → 5),
     then lands on a random "final" image and stops. Total run: 4 fades
     for the cycle + 1 random fade ≈ 25 s of motion, then static.

     Decode-before-show prevents the network-load flash. The dwell + fade
     happens entirely AFTER LCP measurement closes, so the rotation never
     affects the score. #}
<script>
  (function () {
    var wrappers = document.querySelectorAll('.hero-pic-wrapper');
    if (wrappers.length < 2) return;

    var FADE_MS = 700;
    var DWELL_MS = 5000;
    var current = 0;        // currently visible wrapper index
    var fadesDone = 0;      // how many transitions we've performed
    var stopped = false;

    function fadeTo(nextIdx, isFinal) {
      if (stopped) return;
      if (nextIdx === current) {
        if (isFinal) stopped = true;
        return;
      }
      var prev = wrappers[current];
      var next = wrappers[nextIdx];
      var img = next.querySelector('img');
      if (!img) return;

      // Force the network fetch — image is still display:none, no render.
      img.loading = 'eager';

      // decode() resolves only after the bytes are downloaded AND the
      // pixel buffer is ready to render. This is what kills the flash.
      var ready = img.decode ? img.decode() : Promise.resolve();
      ready.then(function () {
        // Ready state: display:block + opacity:0. Two rAFs ensure the
        // browser commits this before we transition to opacity:1.
        next.style.opacity = '0';
        next.classList.remove('hidden');
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            next.style.opacity = '1';
            prev.style.opacity = '0';
          });
        });
        setTimeout(function () {
          prev.classList.add('hidden');
          current = nextIdx;
          fadesDone++;
          if (isFinal) {
            stopped = true;
            return;
          }
          setTimeout(advance, DWELL_MS);
        }, FADE_MS + 100);
      }).catch(function () {
        // Decode failed — skip this image, try the next on schedule.
        setTimeout(advance, DWELL_MS);
      });
    }

    function advance() {
      if (stopped) return;
      // We've done (wrappers.length - 1) fades = shown every wrapper once.
      // The next fade lands on a random image and stops the rotation.
      var willBeFinal = fadesDone >= wrappers.length - 1;
      if (willBeFinal) {
        var finalIdx = Math.floor(Math.random() * wrappers.length);
        fadeTo(finalIdx, true);
      } else {
        fadeTo((current + 1) % wrappers.length, false);
      }
    }

    var started = false;
    function start() {
      if (started) return;
      started = true;
      advance();
    }
    ['scroll', 'click', 'keydown'].forEach(function (ev) {
      document.addEventListener(ev, start, { once: true, passive: true });
    });
    setTimeout(start, 3000);
  })();
</script>

{# ── Announcements banner ─────────────────────────────────────────── #}
{% if announcements.enabled %}
<div class="bg-brand-gold">
  <div class="max-w-screen-xl mx-auto px-4 py-3 flex items-center justify-center gap-3">
    <p class="text-brand-dark text-sm font-bold uppercase tracking-wider text-center [&_a]:underline [&_a]:hover:no-underline">
      {{ announcements.body | markdownify | safe }}
    </p>
  </div>
</div>
{% endif %}

{# ── Cream-background sections ────────────────────────────────────── #}
<div class="bg-brand-cream">

  {# ── Programs grid ──────────────────────────────────────────────── #}
  <section class="max-w-screen-xl mx-auto px-4 pt-14 pb-12">
    <div class="flex items-end justify-between mb-6 flex-wrap gap-2">
      <h2 class="text-3xl md:text-4xl font-extrabold text-brand-red-dark uppercase tracking-tight">Let's Play</h2>
      <a href="/programs/" class="text-brand-red-dark text-sm md:text-base font-bold hover:underline">all soccer programs →</a>
    </div>

    {% set programs = [
      { name: "Spring Soccer",   sub: "6U–19U",                    url: "/programs/spring-soccer/",  img: "home/tile_spring.jpg" },
      { name: "Fall Soccer",     sub: "6U–14U · Core Program",     url: "/programs/fall-soccer/",    img: "home/tile_core.jpg" },
      { name: "EXTRA",           sub: "10U Tryout-Based Select",   url: "/programs/extra/",          img: "home/tile_extra.jpg" },
      { name: "Pre-School",      sub: "4U/5U",                     url: "/programs/preschool/",      img: "home/tile_preschool.jpg" },
      { name: "Upper Division",  sub: "16U–19U",                   url: "/programs/upper-division/", img: "home/tile_upper.jpg" },
      { name: "EPIC",            sub: "Inclusion Program",         url: "/programs/epic/",           img: "home/tile_epic.jpg" }
    ] %}

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {% for p in programs %}
      {# Alternate body/underline colors: odd = lighter body + darker underline, even = darker body + lighter underline #}
      {% set bodyColor = "bg-brand-red/85" if loop.index0 % 2 == 0 else "bg-brand-red-dark/85" %}
      {% set lineColor = "bg-brand-red-dark/85" if loop.index0 % 2 == 0 else "bg-brand-red/85" %}
      <a href="{{ p.url }}" class="relative block aspect-[4/3] group shadow-md hover:shadow-xl transition-shadow rounded-md overflow-hidden">
        <img src="/images/{{ p.img }}" alt="{{ p.name }}" loading="lazy"
             sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
             class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
        {# Semi-transparent label anchored bottom-left, 60% width for consistency #}
        <div class="absolute bottom-0 left-0 w-3/5">
          <div class="{{ bodyColor }} text-white px-4 py-2.5">
            <h3 class="text-lg md:text-xl font-extrabold leading-tight">{{ p.name }}</h3>
            <p class="text-base md:text-lg font-bold opacity-95 mt-0.5">{{ p.sub }}</p>
          </div>
          <div class="h-1.5 {{ lineColor }}"></div>
        </div>
      </a>
      {% endfor %}
    </div>
  </section>

</div>{# /bg-brand-cream #}

{# ── About + Roles ──────────────────────────────────────────────── #}
<section class="bg-white border-y-[6px] border-brand-maroon">
  <div class="max-w-screen-xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      {# About blurb #}
      <div class="lg:col-span-2">
        <div class="flex items-center gap-5 mb-5">
          <img src="/images/logo.svg" alt="" class="h-20 w-20 shrink-0" aria-hidden="true" loading="lazy">
          <h2 class="text-2xl md:text-3xl font-extrabold text-brand-dark uppercase tracking-tight">About AYSO Region 13</h2>
        </div>
        <div class="prose prose-home max-w-none">
          {{ content | safe }}
        </div>
      </div>

      {# Role-based quick links #}
      <div class="bg-brand-maroon rounded-lg p-6 self-start border-4 border-brand-red">
        <h2 class="text-xl font-bold text-white mb-4">I'm a soccer…</h2>
        <div class="flex flex-col gap-2">
          {% set roles = [
            { label: "Parent/Guardian", url: "/families/" },
            { label: "Coach",        url: "/coaches/"    },
            { label: "Referee",      url: "/referees/"   },
            { label: "Team Manager", url: "/managers/"   },
            { label: "Volunteer",    url: "/volunteers/" }
          ] %}
          {% for role in roles %}
          <a href="{{ role.url }}"
             class="block px-5 py-3 bg-transparent border border-white/40 text-white font-semibold rounded hover:bg-white hover:text-brand-maroon transition-colors text-center">
            {{ role.label }}
          </a>
          {% endfor %}
        </div>
      </div>

    </div>
  </div>
</section>

{# ── Photo gallery strip ──────────────────────────────────────────── #}
<section class="bg-brand-maroon-dark">
  <div class="grid grid-cols-1 md:grid-cols-3">
    {% set galleryPhotos = [
      { img: "home/gallery_1.jpg", alt: "Two Region 13 boys compete for the ball on a Saturday game" },
      { img: "home/gallery_2.jpg", alt: "Young Region 13 players in pink uniforms high-five after a play" },
      { img: "home/gallery_3.jpg", alt: "Region 13 girls chase the ball at a practice session" }
    ] %}
    {% for photo in galleryPhotos %}
    <a href="/resources/gallery/" class="block aspect-[4/3] overflow-hidden">
      <img src="/images/{{ photo.img }}" alt="{{ photo.alt }}" loading="lazy"
           sizes="(min-width: 768px) 33vw, 100vw"
           class="w-full h-full object-cover hover:scale-105 transition-transform duration-500">
    </a>
    {% endfor %}
  </div>
  <div class="py-6 text-center">
    <a href="/resources/gallery/" class="inline-block text-white text-lg md:text-xl font-bold hover:underline">
      View Photo Gallery →
    </a>
  </div>
</section>

{# Sponsor strip temporarily removed — re-enable by uncommenting:
{% include "sponsors-strip.njk" %}
#}

