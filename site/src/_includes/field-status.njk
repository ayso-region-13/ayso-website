{# ── Field status bar ────────────────────────────────────────────────
   ONE definition, included by home.njk and page.njk, so the two cannot
   drift (the gtag blocks in base.njk/temp.njk are the cautionary tale).
   Callers gate on their own condition — page.njk on `showFieldStatus`
   frontmatter, home.njk unconditionally — and this file owns the
   `fieldstatus.enabled` check plus all the markup.

   The whole bar links to /resources/weather/, which is where the status
   and the live conditions behind it live. The one exception is that page
   itself: a bar that links to the page you are already on is noise, so
   there it renders as a plain div. #}
{# Black on gold whatever the status: the bar's job is to stop a parent who
   assumes both areas match. Closed flips to gold on black so it reads first. #}
{% macro areaStatus(name, status) %}
<span class="px-2 py-1 text-xl md:text-2xl lg:text-3xl font-extrabold uppercase tracking-wide">{{ name }}: <span class="{{ 'bg-brand-dark text-brand-gold px-2' if status | lower == 'closed' }}">{{ status }}</span></span>
{% endmacro %}
{# Only "Varies by area" splits the bar, so changing the status to anything else
   ends a split even with area values left in the file. #}
{% set fsSplit = (fieldstatus.status | lower == "varies by area") and fieldstatus.laCanadaStatus and fieldstatus.pasadenaStatus %}
{% if fieldstatus.enabled and fsSplit %}
{% set fsHref = "/resources/weather/" %}
<div role="status" class="bg-brand-gold text-brand-dark border-b-4 border-brand-dark">
  {% if page.url != fsHref %}<a href="{{ fsHref }}" class="block hover:bg-black/10 transition-colors">{% endif %}
    <span class="block max-w-screen-xl mx-auto px-4 py-4 md:py-5 text-center">
      <span class="block text-base font-bold uppercase tracking-wider">Field Status</span>
      <span class="grid grid-cols-1 sm:grid-cols-2 gap-1 sm:gap-4 mt-1 sm:mt-2">
        {{ areaStatus("La Cañada", fieldstatus.laCanadaStatus) }}
        {{ areaStatus("Pasadena/Altadena", fieldstatus.pasadenaStatus) }}
      </span>
      {% if fieldstatus.message %}<span class="block mt-2 sm:mt-3 text-base md:text-lg font-semibold">{{ fieldstatus.message }}</span>{% endif %}
      {% if fieldStatusDate %}<span class="block mt-1 text-sm font-medium">Last Updated at {{ fieldStatusDate }}</span>{% endif %}
    </span>
    {% if page.url != fsHref %}<span class="sr-only">See weather and field conditions.</span>{% endif %}
  {% if page.url != fsHref %}</a>{% endif %}
</div>
{% elif fieldstatus.enabled %}
{% set fsHref = "/resources/weather/" %}
{# Only an explicit Open is green: an all-clear color must never be the fallback. #}
{% set fsBg = "bg-brand-red-dark" if fieldstatus.status | lower == "closed" else ("bg-brand-green" if fieldstatus.status | lower == "open" else "bg-brand-gold") %}
{% set fsText = "text-white" if fieldstatus.status | lower == "closed" else "text-brand-dark" %}
{% set fsInner = "max-w-screen-xl mx-auto px-4 py-2.5 flex items-center justify-center gap-3" %}
<div class="{{ fsBg }}" role="status">
  {% if page.url != fsHref %}<a href="{{ fsHref }}" class="{{ fsInner }} hover:bg-black/10 transition-colors">{% else %}<div class="{{ fsInner }}">{% endif %}
    <span class="text-xl" aria-hidden="true">⚽</span>
    <span class="{{ fsText }} text-sm font-bold uppercase tracking-wider text-center">
      Field Status: {{ fieldstatus.status }}{% if fieldstatus.message %} — {{ fieldstatus.message }}{% endif %}
      {% if page.url != fsHref %}<span class="sr-only">. See weather and field conditions.</span>{% endif %}
      {# Build-time git date of fieldstatus.json, already Pacific. Null when
         git can't answer (shallow clone, no repo), in which case say nothing
         rather than show a stale or empty time. #}
      {% if fieldStatusDate %}<span class="block text-xs font-normal normal-case tracking-normal opacity-80">Last Updated at {{ fieldStatusDate }}</span>{% endif %}
    </span>
    <span class="text-xl" aria-hidden="true">⚽</span>
  {% if page.url != fsHref %}</a>{% else %}</div>{% endif %}
</div>
{% endif %}
