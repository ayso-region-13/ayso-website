<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title and title != site.title %}{{ title }} | {{ site.title }}{% else %}{{ site.title }} — {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="theme-color" content="#ffffff">

  <!-- Canonical -->
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  {% if noindex %}<meta name="robots" content="noindex,nofollow">{% endif %}

  {# Schema.org JSON-LD — emits Organization, BreadcrumbList, Place, FAQPage as appropriate #}
  {% include "schema-org.njk" %}

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{% if title and title != site.title %}{{ title }} | {{ site.title }}{% else %}{{ site.title }} — {{ site.tagline }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="en_US">
  {%- set ogImagePath = heroImage or og.sectionDefaults[section] or og.fallback -%}
  {%- set ogImageAlt  = heroImageAlt or (title + " — AYSO Region 13") -%}
  <meta property="og:image" content="{{ site.url }}{{ ogImagePath }}">
  <meta property="og:image:alt" content="{{ ogImageAlt }}">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if title and title != site.title %}{{ title }} | {{ site.title }}{% else %}{{ site.title }} — {{ site.tagline }}{% endif %}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}{{ ogImagePath }}">

  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/images/logo.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Sitemap -->
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700;800;900&display=swap">

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/assets/css/style.css">

  {# Hero image LCP optimization is handled by fetchpriority="high" + loading="eager"
     on the img tag itself (see home.njk). The eleventy-img plugin generates
     hash-named AVIF/WebP/JPEG variants, so a static preload link can't match the
     URL the browser actually fetches. #}

  {% if site.gaId %}
  <!-- Google Analytics — data-cfasync="false" opts out of Cloudflare Rocket Loader,
       which was rewriting type="text/javascript" and breaking pageview reporting. -->
  <script async data-cfasync="false" src="https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}"></script>
  <script data-cfasync="false">
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ site.gaId }}');
  </script>
  {% endif %}
</head>
<body class="font-sans text-gray-800 bg-white min-h-screen flex flex-col">

  <!-- Skip to main content -->
  <a href="#main-content"
     class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:text-brand-red-dark focus:font-semibold focus:px-4 focus:py-2 focus:rounded focus:shadow-lg">
    Skip to main content
  </a>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!--  HEADER / NAVIGATION                                           -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <header class="sticky top-0 z-40 bg-white shadow-sm border-b border-gray-100">
    <div class="max-w-screen-2xl mx-auto px-4">
      <div class="flex items-stretch justify-between">

        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 py-2 shrink-0 hover:opacity-90 transition-opacity" aria-label="AYSO Region 13 Home">
          <img src="/images/logo.svg" alt="" class="h-14 w-14" aria-hidden="true">
          <div class="text-brand-dark leading-tight hidden sm:block">
            <div class="font-bold text-base tracking-tight">AYSO Region 13</div>
            <div class="text-xs text-gray-500">Pasadena Area Youth Soccer</div>
          </div>
        </a>

        <!-- Desktop Navigation (xl+) -->
        <nav class="hidden xl:flex items-stretch" aria-label="Main navigation">
          {% for item in navigation %}{% if item.topNav %}
          <div class="nav-item relative flex items-stretch group">
            <a href="{{ item.url }}"
               class="flex items-center gap-1 px-4 py-2 my-2 text-brand-dark text-sm font-semibold rounded hover:bg-gray-100 hover:text-brand-red-dark transition-colors whitespace-nowrap
                      {% if page.url | isActiveSection(item.url) %}text-brand-red-dark{% endif %}"
               {% if item.children %}aria-haspopup="true"{% endif %}>
              {{ item.label }}
              {% if item.children %}
              <svg class="w-3 h-3 opacity-60 mt-0.5 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
              </svg>
              {% endif %}
            </a>

            {% if item.children %}
            <div class="nav-dropdown rounded-b-lg overflow-hidden" role="menu">
              {% for child in item.children %}
              {% if child.divider %}
              <div class="px-4 pt-3 pb-1">
                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">{{ child.dividerLabel }}</span>
              </div>
              {% endif %}
              <a href="{{ child.url }}"
                 class="block px-4 py-2 text-sm text-gray-700 hover:bg-brand-cream hover:text-brand-red-dark transition-colors
                        {% if page.url == child.url %}bg-brand-cream text-brand-red-dark font-medium{% endif %}"
                 role="menuitem">
                {{ child.label }}
              </a>
              {% endfor %}
            </div>
            {% endif %}
          </div>
          {% endif %}{% endfor %}
        </nav>

        <!-- inLeague login + Mobile toggle -->
        <div class="flex items-center gap-2 py-2">
          <a href="{{ site.inleagueUrl }}" rel="noopener" target="_blank"
             class="inline-flex items-center gap-2 bg-brand-header text-white font-semibold text-sm pl-4 pr-2 py-2 rounded-full hover:bg-brand-maroon transition-colors whitespace-nowrap">
            inLeague
            <span class="inline-flex items-center justify-center w-7 h-7 bg-white text-brand-header rounded-full">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </span>
          </a>
          <!-- Mobile menu button -->
          <button id="mobile-menu-btn"
                  class="xl:hidden p-3 text-brand-dark hover:bg-gray-100 rounded-lg transition-colors"
                  aria-label="Open navigation menu"
                  aria-expanded="false"
                  aria-controls="mobile-menu">
            <svg id="icon-hamburger" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

      </div><!-- end flex row -->
    </div><!-- end container -->

    <!-- ── Mobile Navigation ──────────────────────────────────────── -->
    <div id="mobile-menu"
         role="navigation"
         class="hidden xl:hidden bg-gray-900 border-t border-gray-800 max-h-[80vh] overflow-y-auto"
         aria-label="Mobile navigation">
      <div class="py-2">
        <a href="/register/" class="flex items-center gap-2 mx-4 mb-3 mt-1 bg-brand-gold text-brand-dark font-bold text-sm px-4 py-2.5 rounded-lg justify-center">
          Register Now
        </a>
        {% for item in navigation %}{% if item.topNav %}
        <div class="border-b border-gray-800 last:border-0">
          {% if item.children %}
          <div class="flex items-stretch">
            <a href="{{ item.url }}" class="flex-1 px-4 py-3 text-white font-semibold text-sm hover:bg-gray-800 transition-colors">
              {{ item.label }}
            </a>
            <button class="mobile-expand-btn px-4 py-3 text-gray-400 hover:bg-gray-800 hover:text-white transition-colors"
                    aria-label="Expand {{ item.label }}"
                    aria-expanded="false">
              <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
          </div>
          <div class="mobile-submenu hidden bg-gray-950">
            {% for child in item.children %}
            {% if child.divider %}
            <div class="pl-6 pr-4 pt-2 pb-0.5">
              <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ child.dividerLabel }}</span>
            </div>
            {% endif %}
            <a href="{{ child.url }}" class="block pl-8 pr-4 py-2.5 text-sm text-gray-300 hover:bg-gray-800 hover:text-white transition-colors">
              {{ child.label }}
            </a>
            {% endfor %}
          </div>
          {% else %}
          <a href="{{ item.url }}" class="block px-4 py-3 text-white font-semibold text-sm hover:bg-gray-800 transition-colors">
            {{ item.label }}
          </a>
          {% endif %}
        </div>
        {% endif %}{% endfor %}
      </div>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!--  MAIN CONTENT                                                  -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <main id="main-content" class="flex-1"{% if not noindex %} data-pagefind-body{% endif %}>
    {{ content | safe }}
  </main>

