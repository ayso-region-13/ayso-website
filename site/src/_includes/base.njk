      </div>

      <!-- Search -->
      <div class="border-t border-gray-700 pt-8 pb-6">
        <form action="/search/" method="get" role="search" class="flex gap-2 max-w-sm">
          <label for="footer-search" class="sr-only">Search the site</label>
          <input type="search" id="footer-search" name="q" placeholder="Search the site…"
                 class="flex-1 bg-gray-800 text-white placeholder-gray-500 border border-gray-600 rounded-lg px-4 py-2 text-sm focus:outline-none focus:border-brand-red">
          <button type="submit" class="bg-brand-gold text-brand-dark px-4 py-2 rounded-lg text-sm font-medium hover:bg-yellow-300 transition-colors whitespace-nowrap">
