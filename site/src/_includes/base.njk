  <!-- ── Navigation JS ─────────────────────────────────────────────── -->
  <script>
    (function () {
      // Mobile menu toggle
      var btn  = document.getElementById('mobile-menu-btn');
      var menu = document.getElementById('mobile-menu');
      var iconHamburger = document.getElementById('icon-hamburger');
      var iconClose     = document.getElementById('icon-close');

      function openMenu() {
        menu.classList.remove('hidden');
        iconHamburger.classList.add('hidden');
        iconClose.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
      function closeMenu() {
        menu.classList.add('hidden');
        iconHamburger.classList.remove('hidden');
        iconClose.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }

      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        menu.classList.contains('hidden') ? openMenu() : closeMenu();
      });

      document.addEventListener('click', function (e) {
        if (!menu.classList.contains('hidden') && !menu.contains(e.target) && !btn.contains(e.target)) {
          closeMenu();
        }
      });

      // Mobile submenu accordions
      document.querySelectorAll('.mobile-expand-btn').forEach(function (expandBtn) {
        expandBtn.addEventListener('click', function () {
          var submenu = this.closest('div').nextElementSibling;
          var icon    = this.querySelector('svg');
          var isOpen  = !submenu.classList.contains('hidden');
          submenu.classList.toggle('hidden');
          icon.style.transform = isOpen ? '' : 'rotate(180deg)';
          this.setAttribute('aria-expanded', String(!isOpen));
        });
      });

      // Close mobile menu on link click (for SPA-like feel)
      if (menu) {
        menu.querySelectorAll('a').forEach(function (link) {
          link.addEventListener('click', closeMenu);
        });
      }
    })();
  </script>

</body>
</html>
