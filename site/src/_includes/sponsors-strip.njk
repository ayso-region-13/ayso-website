{# ── Sponsors strip — used on home page and sponsors page ──────────── #}
<section class="bg-gray-50 border-t border-gray-100 py-10">
  <div class="max-w-screen-xl mx-auto px-4">

    <p class="text-center text-xs font-semibold text-gray-400 uppercase tracking-widest mb-8">
      Thank you to our sponsors
    </p>

    {# Main sponsors #}
    <div class="flex flex-wrap items-center justify-center gap-10 md:gap-14">
      {% for s in sponsors.current %}
      <a href="{{ s.url }}"
         target="_blank" rel="noopener"
         class="opacity-70 hover:opacity-100 transition-opacity"
         title="{{ s.name }}">
        <img src="/images/{{ s.logo }}"
             alt="{{ s.name }}"
             loading="lazy"
             sizes="140px"
             class="h-10 w-auto max-w-[140px] object-contain">
      </a>
      {% endfor %}
    </div>

    {# In-kind / technology partners #}
    {% if sponsors.inKind.length %}
    <div class="mt-8 pt-6 border-t border-gray-200">
      <p class="text-center text-xs text-gray-400 uppercase tracking-widest mb-5">In-kind partners</p>
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
        {% for s in sponsors.inKind %}
        <a href="{{ s.url }}"
           target="_blank" rel="noopener"
           class="opacity-50 hover:opacity-80 transition-opacity grayscale hover:grayscale-0"
           title="{{ s.name }}">
          <img src="/images/{{ s.logo }}"
               alt="{{ s.name }}"
               sizes="100px"
               class="h-6 w-auto max-w-[100px] object-contain">
        </a>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    <p class="text-center mt-8">
      <a href="/volunteers/sponsors/" class="text-sm text-gray-500 hover:text-brand-red-dark transition-colors">
        Become a sponsor →
      </a>
    </p>

  </div>
</section>
