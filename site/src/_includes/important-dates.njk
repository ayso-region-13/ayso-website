{# ── Important Dates column ───────────────────────────────────────────
   Used inside the About + Roles section on the home page as the middle
   column. Renders up to 5 upcoming events from _data/importantDates.json
   (synced hourly from the Google Calendar). Inline script re-checks each
   card's data-date against today (Pacific time) and hides events whose last day (data-end-date, the
   start date for single-day events) has passed — so the widget never shows
   stale dates between publishes. Without JS, the build-time filter is
   accurate as of the last publish.

   This partial is conditionally included by home.njk; the column is
   wrapped in <div id="important-dates"> so the JS can target it.
   Empty/disabled state is handled by home.njk (it omits the include
   entirely and switches the surrounding grid back to 2-col). #}

{% set upcoming = importantDates.dates | upcomingEvents(5) %}
<div id="important-dates">
  <div class="flex items-center gap-3 mb-4">
    <h2 class="text-xl md:text-2xl font-extrabold text-brand-dark uppercase tracking-tight">Upcoming Dates</h2>
  </div>

  <ul class="space-y-2">
    {% for ev in upcoming %}
    <li class="date-card" data-date="{{ ev.date }}" data-end-date="{{ ev.endDate or ev.date }}">
      {% if ev.link %}
      <a href="{{ ev.link }}" class="block bg-brand-cream border-l-4 border-brand-red-dark px-4 py-3 hover:bg-brand-cream/70 transition-colors">
        <div class="text-xs font-bold uppercase tracking-wider text-brand-red-dark">{{ ev.date | shortDate }}</div>
        <div class="text-sm font-semibold text-brand-dark mt-1 leading-snug">{{ ev.name }}</div>
      </a>
      {% else %}
      <div class="block bg-brand-cream border-l-4 border-brand-red-dark px-4 py-3">
        <div class="text-xs font-bold uppercase tracking-wider text-brand-red-dark">{{ ev.date | shortDate }}</div>
        <div class="text-sm font-semibold text-brand-dark mt-1 leading-snug">{{ ev.name }}</div>
      </div>
      {% endif %}
    </li>
    {% endfor %}
  </ul>

  <a href="/about/calendar/" class="inline-block mt-4 text-sm font-semibold text-brand-red-dark hover:underline">See all events →</a>
</div>
<script>
  (function () {
    var today = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Los_Angeles', year: 'numeric', month: '2-digit', day: '2-digit'
    }).format(new Date());
    var section = document.getElementById('important-dates');
    if (!section) return;
    var cards = section.querySelectorAll('.date-card');
    var visible = 0;
    cards.forEach(function (c) {
      var end = c.dataset.endDate || c.dataset.date;
      if (!end) return;
      if (end < today) {
        c.hidden = true;
      } else {
        visible++;
      }
    });
    if (visible === 0) section.hidden = true;
  })();
</script>
