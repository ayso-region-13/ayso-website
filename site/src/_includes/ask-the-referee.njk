---
layout: base.njk
---
{# ── Ask the Referee — accordion FAQ layout ──────────────────────────── #}

{% set sectionNav = null %}
{% for navItem in navigation %}
  {% if page.url | isActiveSection(navItem.url) %}
    {% set sectionNav = navItem %}
  {% endif %}
{% endfor %}

{# Category display order #}
{% set categoryOrder = [
  "Goalkeeper Rules",
  "Offside",
  "Fouls & Misconduct",
  "Restarts",
  "Equipment & Player Safety",
  "Age Group Rules (AYSO-Specific)",
  "Officiating & Mechanics"
] %}

{# ── Page header ─────────────────────────────────────────────────────── #}
<div class="bg-brand-cream">
  <div class="max-w-screen-xl mx-auto px-4 py-8 md:py-10">
    {% if sectionNav and sectionNav.url != page.url %}
    <nav class="text-sm text-brand-maroon mb-3" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-dark transition-colors">Home</a>
      <span class="mx-2 opacity-40">/</span>
      <a href="{{ sectionNav.url }}" class="hover:text-brand-dark transition-colors">{{ sectionNav.label }}</a>
      <span class="mx-2 opacity-40">/</span>
      <span class="text-brand-dark font-medium">{{ title }}</span>
    </nav>
    {% endif %}
    <h1 class="text-3xl md:text-4xl font-extrabold text-brand-dark leading-tight">{{ title }}</h1>
    {% if description %}
    <p class="mt-2 text-brand-maroon text-lg leading-relaxed max-w-2xl">{{ description }}</p>
    {% endif %}
  </div>
</div>

{# ── Two-tone signature strip ────────────────────────────────────────── #}
<div class="h-1.5 bg-brand-maroon"></div>
<div class="h-1 bg-brand-red"></div>

{# ── Content area ────────────────────────────────────────────────────── #}
<div class="max-w-screen-xl mx-auto px-4 py-10">
  <div class="flex flex-col lg:flex-row gap-10">

    {# Main content #}
    <article class="flex-1 min-w-0">

      {# Intro + submit button #}
      <div class="mb-8">
        <p class="text-gray-700 mb-4">Our Advisor on the Laws of the Game, Steve Hawkins, takes a few minutes to answer a question. Browse the answers below, or submit your own.</p>
        <a href="https://ayso13.typeform.com/to/Ax4Bm7HD" target="_blank" rel="noopener"
           class="inline-block bg-brand-gold text-brand-dark font-semibold px-5 py-2.5 rounded-lg hover:bg-yellow-400 transition-colors">
          Submit a Question
        </a>
      </div>

      {# Section jump links #}
      <nav id="toc" class="mb-8 p-4 bg-gray-50 rounded-xl border border-gray-200" aria-label="Jump to section">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Jump to section</p>
        <ul class="flex flex-wrap gap-x-4 gap-y-1">
          {% for cat in categoryOrder %}
          <li>
            <a href="#{{ cat | slug }}"
               class="text-sm text-brand-red-dark hover:text-brand-maroon hover:underline transition-colors">
              {{ cat }}
            </a>
          </li>
          {% endfor %}
        </ul>
      </nav>

      {# Q&A sections by category #}
      {% for cat in categoryOrder %}
        {% set catItems = [] %}
        {% for item in collections.qaAnswers %}
          {% if item.data.category == cat %}
            {% set catItems = (catItems.push(item), catItems) %}
          {% endif %}
        {% endfor %}

        {% if catItems.length > 0 %}
        <section id="{{ cat | slug }}" class="mb-10">
          <h2 class="text-xl font-bold text-brand-red-dark border-b-2 border-brand-red-dark pb-2 mb-1">{{ cat }}</h2>
          <p class="text-sm text-gray-500 mb-4">{{ catItems.length }} question{% if catItems.length != 1 %}s{% endif %}</p>

          <div class="divide-y divide-gray-200 border border-gray-200 rounded-xl overflow-hidden">
            {% for item in catItems %}
            <details class="group">
              <summary class="flex items-start justify-between gap-4 px-5 py-4 cursor-pointer list-none hover:bg-brand-cream transition-colors">
                <span class="font-medium text-brand-dark group-open:text-brand-red-dark transition-colors">
                  {{ item.data.question }}
                </span>
                <span class="shrink-0 mt-0.5 text-gray-400 group-open:text-brand-red-dark transition-colors" aria-hidden="true">
                  <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                  </svg>
                </span>
              </summary>
              <div class="px-5 py-4 bg-white border-t border-gray-100">
                <div class="prose prose-sm max-w-none">
                  {{ item.templateContent | safe }}
                </div>
                {% if item.date %}
                <p class="mt-3 text-xs text-gray-400 italic">Answered {{ item.date | readableDate }}</p>
                {% endif %}
              </div>
            </details>
            {% endfor %}
          </div>
          <a href="#toc" class="inline-block mt-4 text-xs text-gray-400 hover:text-brand-red-dark transition-colors">↑ Back to top</a>
        </section>
        {% endif %}
      {% endfor %}

      {# Related pages #}
      <div class="mt-10 pt-6 border-t border-gray-200">
        <h2 class="text-lg font-semibold text-brand-dark mb-3">Related Pages</h2>
        <ul class="space-y-1 text-sm">
          <li><a href="/referees/laws/" class="text-brand-red hover:underline">Laws of the Game</a> — Official rulebook references</li>
          <li><a href="/referees/faqs/" class="text-brand-red hover:underline">Referee FAQs</a> — Scheduling, uniforms, and game-day questions</li>
          <li><a href="/referees/training/" class="text-brand-red hover:underline">Referee Training</a> — Certification and courses</li>
        </ul>
      </div>

    </article>

    {# Sidebar #}
    {% if sectionNav and sectionNav.children %}
    <aside class="lg:w-64 shrink-0">
      <nav class="sticky top-20" aria-label="Section navigation">
        <div class="bg-gray-50 rounded-xl border border-gray-200 overflow-hidden">
          <div class="bg-brand-maroon text-white px-4 py-3">
            <p class="text-sm font-semibold">{{ sectionNav.label }}</p>
          </div>
          <ul>
            {% for child in sectionNav.children %}
            {% if child.divider %}
            <li class="px-4 pt-3 pb-1">
              <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">{{ child.dividerLabel }}</span>
            </li>
            {% endif %}
            <li>
              <a href="{{ child.url }}"
                 class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-brand-cream hover:text-brand-red-dark transition-colors border-b border-gray-100 last:border-0
                        {% if page.url == child.url %}bg-brand-cream text-brand-red-dark font-medium{% endif %}">
                {{ child.label }}
              </a>
            </li>
            {% endfor %}
          </ul>
        </div>
      </nav>
    </aside>
    {% endif %}

  </div>
</div>
