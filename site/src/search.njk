---
layout: base.njk
title: Search
description: Search all pages on the AYSO Region 13 website.
permalink: /search/
---

<link rel="stylesheet" href="/pagefind/pagefind-component-ui.css">

<!-- Page header -->
<div class="bg-brand-cream">
  <div class="max-w-screen-xl mx-auto px-4 py-8 md:py-10">
    <h1 class="text-3xl md:text-4xl font-extrabold text-brand-dark leading-tight">Search</h1>
    <p class="mt-2 text-brand-maroon text-lg leading-relaxed max-w-2xl">Find anything on the AYSO Region 13 website — programs, fields, coaches, referees, and more.</p>
  </div>
</div>

<!-- Two-tone signature strip -->
<div class="h-1.5 bg-brand-maroon"></div>
<div class="h-1 bg-brand-red"></div>

<div class="max-w-2xl mx-auto px-4 py-12">
  <pagefind-input autofocus placeholder="Search the site…"></pagefind-input>
  <pagefind-summary class="mt-4 block"></pagefind-summary>
  <pagefind-results class="mt-4 block"></pagefind-results>
  <p id="search-fallback" class="text-sm text-gray-500 mt-6 text-center hidden">
    Search is only available on the live site. <a href="/" class="text-brand-red-dark hover:underline">Return home</a>.
  </p>
</div>

<style>
  /* Theme Pagefind Component UI with brand colors */
  :root {
    --pf-text: #221F1F;             /* brand-dark */
    --pf-text-secondary: #4b5563;
    --pf-text-muted: #6b7280;
    --pf-background: #ffffff;
    --pf-border: #d1d5db;
    --pf-border-focus: #83312D;     /* brand-red-dark */
    --pf-hover: #ede8e2;             /* brand-cream */
    --pf-mark: #221F1F;             /* mark text color */
    --pf-outline-focus: #83312D;
    --pf-font: inherit;             /* Raleway (set globally) */
    --pf-border-radius: 8px;
    --pf-input-height: 48px;
    --pf-input-font-size: 18px;
    --pf-result-title-font-size: 17px;
    --pf-result-excerpt-font-size: 15px;
  }
  /* Brand-gold match highlight, matching the original Default UI styling.
     !important is required because the Component UI's own rule uses a
     specificity-boosting :is(*, #\#) trick to set the default mark style
     to a transparent background + brand-dark text. */
  .pf-result-excerpt mark,
  .pf-heading-excerpt mark,
  .pf-searchbox-result-excerpt mark,
  pagefind-results mark,
  pagefind-summary mark {
    background: #f4bd4d !important;
    color: #221F1F !important;
    padding: 0 2px;
    border-radius: 2px;
    font-weight: 600;
  }
</style>

<script src="/pagefind/pagefind-component-ui.js" type="module"></script>
<script>
  (function () {
    // ?q= URL pre-fill — wait for the custom element to be defined first.
    var params = new URLSearchParams(window.location.search);
    var q = params.get('q');

    if (window.customElements && customElements.whenDefined) {
      customElements.whenDefined('pagefind-input').then(function () {
        if (q) {
          var host = document.querySelector('pagefind-input');
          // The shadow-DOM input is what receives focus/input events; in
          // light DOM the element exposes a `value` property too.
          if (host && 'value' in host) {
            host.value = q;
          }
          var innerInput = (host && host.shadowRoot)
            ? host.shadowRoot.querySelector('input')
            : (host && host.querySelector('input'));
          if (innerInput) {
            innerInput.value = q;
            innerInput.dispatchEvent(new Event('input', { bubbles: true }));
          }
        }
      });
    }

    // Fallback message if the Component UI module never loads (e.g. dev
    // server without an index built). Show after 1.5s if the custom
    // element still isn't defined.
    setTimeout(function () {
      if (!(window.customElements && customElements.get('pagefind-input'))) {
        var fb = document.getElementById('search-fallback');
        if (fb) fb.classList.remove('hidden');
      }
    }, 1500);
  })();
</script>
