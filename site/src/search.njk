---
layout: base.njk
title: Search
description: Search all pages on the AYSO Region 13 website.
permalink: /search/
---

<link rel="stylesheet" href="/pagefind/pagefind-ui.css">

<!-- Page header -->
<div class="bg-brand-cream">
  <div class="max-w-screen-xl mx-auto px-4 py-8 md:py-10">
    <h1 class="text-3xl md:text-4xl font-extrabold text-brand-dark leading-tight">Search</h1>
    <p class="mt-2 text-brand-maroon text-lg leading-relaxed max-w-2xl">Find anything on the AYSO Region 13 website — programs, fields, coaches, referees, and more.</p>
  </div>
</div>

<!-- Two-tone signature strip -->
<div class="h-1.5 bg-brand-maroon"></div>
<div class="h-1 bg-brand-red"></div>

<div class="max-w-2xl mx-auto px-4 py-12">
  <div id="search"></div>
  <p id="search-fallback" class="text-sm text-gray-500 mt-6 text-center hidden">
    Search is only available on the live site. <a href="/" class="text-brand-red-dark hover:underline">Return home</a>.
  </p>
</div>

<style>
  /* Pagefind UI overrides to match site brand */
  :root {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: #83312d;
    --pagefind-ui-text: #1f2937;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #d1d5db;
    --pagefind-ui-tag: #f3f4f6;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-image-border-radius: 6px;
    --pagefind-ui-font: inherit;
  }
  /* Keep left space for the magnifying-glass icon Pagefind injects.
     Default padding override was clobbering that space. */
  .pagefind-ui__search-input {
    font-size: 1.125rem !important;
    padding: 0.875rem 1rem 0.875rem 2.75rem !important;
  }
  .pagefind-ui__search-clear {
    color: #6b7280;
  }
  /* Search result match highlights — use brand-gold instead of browser default yellow */
  .pagefind-ui mark {
    background: #f4bd4d;
    color: #221f1f;
    padding: 0 2px;
    border-radius: 2px;
  }
</style>

<script src="/pagefind/pagefind-ui.js"></script>
<script>
  (function () {
    if (typeof PagefindUI === 'undefined') {
      document.getElementById('search-fallback').classList.remove('hidden');
      return;
    }
    new PagefindUI({
      element: '#search',
      showSubResults: true,
      showImages: false,
      excerptLength: 25,
      resetStyles: false
    });
    // Pre-fill from ?q= URL param
    var params = new URLSearchParams(window.location.search);
    var q = params.get('q');
    if (q) {
      var input = document.querySelector('.pagefind-ui__search-input');
      if (input) {
        input.value = q;
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
    }
  })();
</script>
