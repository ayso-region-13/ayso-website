<style>
  .filter-btn {
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid #d1d5db;
    background: white;
    color: #374151;
    cursor: pointer;
    transition: all 0.15s;
  }
  .filter-btn:hover {
    border-color: #ce0e2d;
    color: #ce0e2d;
  }
  .filter-btn.active {
    background: #ce0e2d;
    border-color: #ce0e2d;
    color: white;
  }
  .gallery-item.hidden {
    display: none;
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/glightbox@3/dist/js/glightbox.min.js"></script>
<script>
  (function () {
    function applyFilter(filter) {
      // Update visible items and the lb-active class (used as GLightbox selector)
      document.querySelectorAll('.gallery-item').forEach(function (item) {
        var visible = filter === 'all' || item.dataset.category === filter;
        item.classList.toggle('hidden', !visible);
        item.querySelector('a').classList.toggle('lb-active', visible);
      });

      // Destroy and recreate lightbox targeting only visible items
      if (window._galleryLb) window._galleryLb.destroy();
      window._galleryLb = GLightbox({ selector: '.lb-active', loop: true, touchNavigation: true, zoomable: false });
    }

    // Initialise with all photos visible
    applyFilter('all');

    document.querySelectorAll('.filter-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        document.querySelectorAll('.filter-btn').forEach(function (b) { b.classList.remove('active'); });
        this.classList.add('active');
        applyFilter(this.dataset.filter);
      });
    });
  })();
</script>
