# direnv configuration for the AYSO Region 13 website repo.
#
# Secrets are read from 1Password (my.1password.com, vault Dev) each time
# direnv loads this file. No plaintext copy lives on disk. The variables,
# the claude-seo symlink logic, and their comments are in .envrc.tpl;
# edit that file, not this one. See docs/1password-migration.md.
#
# Setup:
#   1. cp .envrc.example .envrc   (the real .envrc is gitignored)
#   2. direnv allow
#
# 1Password asks for approval when direnv loads this in a new shell. If
# it can't (locked, signed out), direnv prints an error and loads nothing.

watch_file .envrc.tpl

if secrets="$(op inject --account=my.1password.com -i .envrc.tpl)"; then
  eval "$secrets"
else
  log_error "op inject failed (is 1Password unlocked?); secrets not loaded"
fi
unset secrets
